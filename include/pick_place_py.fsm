NAME: pick_place

STATES:
    S_IDLE,
    S_POSE_DETECTION,
    S_MOVE_ARM,
    S_CLOSE_GRIPPER,
    S_MOVE_TO_PLACE,
    S_OPEN_GRIPPER,
    S_FINISHED,
    S_MOVE_ARM_HOME,
    S_ABORT,
    S_EXIT

START_STATE: @S_IDLE
CURRENT_STATE: @S_IDLE
END_STATE: @S_EXIT

EVENTS:
    E_START,
    E_GO_HOME,
    E_PERCEPTION_POSE,
    E_PERCEPTION_FAIL,
    E_ARM_MOVE_DONE_OK,
    E_ARM_MOVE_DONE_FAIL,
    E_GRIPPER_CLOSE_DONE_OK,
    E_GRIPPER_CLOSE_DONE_FAIL,
    E_PLACE_DONE_OK,
    E_PLACE_DONE_FAIL,
    E_OPEN_DONE_OK,
    E_OPEN_DONE_FAIL,
    E_HOME_DONE_OK,
    E_HOME_DONE_FAIL,
    E_RESET

TRANSITIONS:
    T_IDLE_POSE_DETECTION:
        FROM: @S_IDLE
        TO: @S_POSE_DETECTION
    T_IDLE_HOME:
        FROM: @S_IDLE
        TO: @S_MOVE_ARM_HOME

    T_POSE_DETECTION_MOVE_ARM:
        FROM: @S_POSE_DETECTION
        TO: @S_MOVE_ARM
    T_POSE_DETECTION_IDLE:
        FROM: @S_POSE_DETECTION
        TO: @S_IDLE

    T_MOVE_ARM_CLOSE_GRIPPER:
        FROM: @S_MOVE_ARM
        TO: @S_CLOSE_GRIPPER
    T_MOVE_ARM_ABORT:
        FROM: @S_MOVE_ARM
        TO: @S_ABORT

    T_CLOSE_GRIPPER_MOVE_TO_PLACE:
        FROM: @S_CLOSE_GRIPPER
        TO: @S_MOVE_TO_PLACE
    T_CLOSE_GRIPPER_ABORT:
        FROM: @S_CLOSE_GRIPPER
        TO: @S_ABORT

    T_PLACE_OPEN_GRIPPER:
        FROM: @S_MOVE_TO_PLACE
        TO: @S_OPEN_GRIPPER
    T_PLACE_ABORT:
        FROM: @S_MOVE_TO_PLACE
        TO: @S_ABORT

    T_OPEN_FINISHED:
        FROM: @S_OPEN_GRIPPER
        TO: @S_FINISHED
    T_OPEN_ABORT:
        FROM: @S_OPEN_GRIPPER
        TO: @S_ABORT

    T_FINISHED_HOME:
        FROM: @S_FINISHED
        TO: @S_MOVE_ARM_HOME
    T_FINISHED_IDLE:
        FROM: @S_FINISHED
        TO: @S_IDLE

    T_HOME_IDLE:
        FROM: @S_MOVE_ARM_HOME
        TO: @S_IDLE
    T_HOME_ABORT:
        FROM: @S_MOVE_ARM_HOME
        TO: @S_ABORT

    T_ABORT_IDLE:
        FROM: @S_ABORT
        TO: @S_IDLE

REACTIONS:
    R_E_START:
        WHEN: @E_START
        DO: @T_IDLE_POSE_DETECTION
    R_E_GO_HOME_IDLE:
        WHEN: @E_GO_HOME
        DO: @T_IDLE_HOME

    R_E_PERCEPTION_POSE:
        WHEN: @E_PERCEPTION_POSE
        DO: @T_POSE_DETECTION_MOVE_ARM
    R_E_PERCEPTION_FAIL:
        WHEN: @E_PERCEPTION_FAIL
        DO: @T_POSE_DETECTION_IDLE

    R_E_ARM_MOVE_DONE_OK:
        WHEN: @E_ARM_MOVE_DONE_OK
        DO: @T_MOVE_ARM_CLOSE_GRIPPER
    R_E_ARM_MOVE_DONE_FAIL:
        WHEN: @E_ARM_MOVE_DONE_FAIL
        DO: @T_MOVE_ARM_ABORT

    R_E_GRIPPER_CLOSE_DONE_OK:
        WHEN: @E_GRIPPER_CLOSE_DONE_OK
        DO: @T_CLOSE_GRIPPER_MOVE_TO_PLACE
    R_E_GRIPPER_CLOSE_DONE_FAIL:
        WHEN: @E_GRIPPER_CLOSE_DONE_FAIL
        DO: @T_CLOSE_GRIPPER_ABORT

    R_E_PLACE_DONE_OK:
        WHEN: @E_PLACE_DONE_OK
        DO: @T_PLACE_OPEN_GRIPPER
    R_E_PLACE_DONE_FAIL:
        WHEN: @E_PLACE_DONE_FAIL
        DO: @T_PLACE_ABORT

    R_E_OPEN_DONE_OK:
        WHEN: @E_OPEN_DONE_OK
        DO: @T_OPEN_FINISHED
    R_E_OPEN_DONE_FAIL:
        WHEN: @E_OPEN_DONE_FAIL
        DO: @T_OPEN_ABORT

    R_E_GO_HOME_FINISHED:
        WHEN: @E_GO_HOME
        DO: @T_FINISHED_HOME
    R_E_RESET_FINISHED:
        WHEN: @E_RESET
        DO: @T_FINISHED_IDLE

    R_E_HOME_DONE_OK:
        WHEN: @E_HOME_DONE_OK
        DO: @T_HOME_IDLE
    R_E_HOME_DONE_FAIL:
        WHEN: @E_HOME_DONE_FAIL
        DO: @T_HOME_ABORT

    R_E_RESET_ABORT:
        WHEN: @E_RESET
        DO: @T_ABORT_IDLE
