NAME: pick_place

STATES:
    S_IDLE,
    S_MOVE_TO_APPROACH,
    S_MOVE_TO_GRASP,
    S_CLOSE_GRIPPER,
    S_MOVE_TO_PLACE,
    S_OPEN_GRIPPER,
    S_FINISHED,
    S_ABORT,
    S_EXIT

START_STATE: @S_IDLE
CURRENT_STATE: @S_IDLE
END_STATE: @S_EXIT

EVENTS:
    E_PERCEPTION_POSE,
    E_APPROACH_DONE_OK,
    E_APPROACH_DONE_FAIL,
    E_GRASP_DONE_OK,
    E_GRASP_DONE_FAIL,
    E_GRIPPER_CLOSE_DONE_OK,
    E_GRIPPER_CLOSE_DONE_FAIL,
    E_PLACE_DONE_OK,
    E_PLACE_DONE_FAIL,
    E_OPEN_DONE_OK,
    E_OPEN_DONE_FAIL,
    E_RESET

TRANSITIONS:
    T_IDLE_MOVE_TO_APPROACH:
        FROM: @S_IDLE
        TO: @S_MOVE_TO_APPROACH


    T_APPROACH_MOVE_TO_GRASP:
        FROM: @S_MOVE_TO_APPROACH
        TO: @S_MOVE_TO_GRASP
    T_APPROACH_ABORT:
        FROM: @S_MOVE_TO_APPROACH
        TO: @S_ABORT


    T_GRASP_CLOSE_GRIPPER:
        FROM: @S_MOVE_TO_GRASP
        TO: @S_CLOSE_GRIPPER
    T_GRASP_ABORT:
        FROM: @S_MOVE_TO_GRASP
        TO: @S_ABORT


    T_CLOSE_GRIPPER_MOVE_TO_PLACE:
        FROM: @S_CLOSE_GRIPPER
        TO: @S_MOVE_TO_PLACE
    T_CLOSE_GRIPPER_ABORT:
        FROM: @S_CLOSE_GRIPPER
        TO: @S_ABORT


    T_PLACE_OPEN_GRIPPER:
        FROM: @S_MOVE_TO_PLACE
        TO: @S_OPEN_GRIPPER
    T_PLACE_ABORT:
        FROM: @S_MOVE_TO_PLACE
        TO: @S_ABORT


    T_OPEN_FINISHED:
        FROM: @S_OPEN_GRIPPER
        TO: @S_FINISHED
    T_OPEN_ABORT:
        FROM: @S_OPEN_GRIPPER
        TO: @S_ABORT


    T_FINISHED_IDLE:
        FROM: @S_FINISHED
        TO: @S_IDLE
    T_ABORT_IDLE:
        FROM: @S_ABORT
        TO: @S_IDLE

REACTIONS:

    R_E_PERCEPTION_POSE:
        WHEN: @E_PERCEPTION_POSE
        DO: @T_IDLE_MOVE_TO_APPROACH


    R_E_APPROACH_DONE_OK:
        WHEN: @E_APPROACH_DONE_OK
        DO: @T_APPROACH_MOVE_TO_GRASP
    R_E_APPROACH_DONE_FAIL:
        WHEN: @E_APPROACH_DONE_FAIL
        DO: @T_APPROACH_ABORT


    R_E_GRASP_DONE_OK:
        WHEN: @E_GRASP_DONE_OK
        DO: @T_GRASP_CLOSE_GRIPPER
    R_E_GRASP_DONE_FAIL:
        WHEN: @E_GRASP_DONE_FAIL
        DO: @T_GRASP_ABORT


    R_E_GRIPPER_CLOSE_DONE_OK:
        WHEN: @E_GRIPPER_CLOSE_DONE_OK
        DO: @T_CLOSE_GRIPPER_MOVE_TO_PLACE
    R_E_GRIPPER_CLOSE_DONE_FAIL:
        WHEN: @E_GRIPPER_CLOSE_DONE_FAIL
        DO: @T_CLOSE_GRIPPER_ABORT

    R_E_PLACE_DONE_OK:
        WHEN: @E_PLACE_DONE_OK
        DO: @T_PLACE_OPEN_GRIPPER
    R_E_PLACE_DONE_FAIL:
        WHEN: @E_PLACE_DONE_FAIL
        DO: @T_PLACE_ABORT

    R_E_OPEN_DONE_OK:
        WHEN: @E_OPEN_DONE_OK
        DO: @T_OPEN_FINISHED
    R_E_OPEN_DONE_FAIL:
        WHEN: @E_OPEN_DONE_FAIL
        DO: @T_OPEN_ABORT


    R_E_RESET_FINISHED:
        WHEN: @E_RESET
        DO: @T_FINISHED_IDLE
    R_E_RESET_ABORT:
        WHEN: @E_RESET
        DO: @T_ABORT_IDLE
