NAME: door_disassemble
DESCRIPTION: "FSM for door workflow staging with dummy perception data."

STATES:
    S_IDLE,
    S_INITIALIZE,
    S_MOVE_TO_VIEW_POSE,
    S_GET_SUBDOOR,
    S_RASTER_SCAN,
    S_GET_OBJECTS,
    S_RETURN_TO_HOME_POSE,
    S_MOVE_ARM,
    S_EXECUTE_SCREWDRIVER_PROBE,
    S_SELECT_NEXT_OBJECT,
    S_CLOSE_GRIPPER,
    S_RETREAT_ARM_WITH_OBJECT,
    S_MOVE_TO_TABLE_DROP_POSE,
    S_OPEN_GRIPPER,
    S_RETURN_HOME_AFTER_DROP,
    S_CONFIRM_DATA,
    S_EXIT

START_STATE: @S_IDLE
CURRENT_STATE: @S_IDLE
END_STATE: @S_EXIT

EVENTS:
    E_START,
    E_ABORT,
    E_INIT_DONE,
    E_INIT_FAIL,
    E_VIEW_POSE_DONE,
    E_VIEW_POSE_FAIL,
    E_SUBDOOR_DONE,
    E_SUBDOOR_FAIL,
    E_SCAN_DONE,
    E_SCAN_FAIL,
    E_RETURN_HOME_DONE,
    E_RETURN_HOME_FAIL,
    E_SCREWDRIVER_PROBE_DONE,
    E_SCREWDRIVER_PROBE_FAIL,
    E_OBJECT_READY,
    E_NO_MORE_OBJECTS,
    E_PICK_OBJECT_DONE,
    E_RETREAT_WITH_OBJECT_DONE,
    E_MOVE_TO_TABLE_DONE,
    E_POST_DROP_HOME_DONE,
    E_POST_DROP_HOME_FAIL,
    E_ARM_MOVE_FAIL,
    E_GRIPPER_CLOSE_DONE,
    E_GRIPPER_OPEN_DONE,
    E_GRIPPER_FAIL,
    E_OBJECTS_DONE,
    E_OBJECTS_FAIL,
    E_GO_MOVE_ARM,
    E_CONFIRM_DONE

TRANSITIONS:
    T_IDLE_INITIALIZE:
        FROM: @S_IDLE
        TO: @S_INITIALIZE
    T_IDLE_EXIT:
        FROM: @S_IDLE
        TO: @S_EXIT

    T_INITIALIZE_MOVE_TO_VIEW_POSE:
        FROM: @S_INITIALIZE
        TO: @S_MOVE_TO_VIEW_POSE
    T_INITIALIZE_EXIT:
        FROM: @S_INITIALIZE
        TO: @S_EXIT
    T_INITIALIZE_ABORT_EXIT:
        FROM: @S_INITIALIZE
        TO: @S_EXIT

    T_MOVE_TO_VIEW_POSE_MOVE_ARM:
        FROM: @S_MOVE_TO_VIEW_POSE
        TO: @S_MOVE_ARM
    T_MOVE_TO_VIEW_POSE_EXIT:
        FROM: @S_MOVE_TO_VIEW_POSE
        TO: @S_EXIT
    T_MOVE_TO_VIEW_POSE_ABORT_EXIT:
        FROM: @S_MOVE_TO_VIEW_POSE
        TO: @S_EXIT

    T_GET_SUBDOOR_GET_OBJECTS:
        FROM: @S_GET_SUBDOOR
        TO: @S_GET_OBJECTS
    T_GET_SUBDOOR_EXIT:
        FROM: @S_GET_SUBDOOR
        TO: @S_EXIT
    T_GET_SUBDOOR_ABORT_EXIT:
        FROM: @S_GET_SUBDOOR
        TO: @S_EXIT

    T_GET_OBJECTS_RASTER_SCAN:
        FROM: @S_GET_OBJECTS
        TO: @S_RASTER_SCAN
    T_GET_OBJECTS_EXIT:
        FROM: @S_GET_OBJECTS
        TO: @S_EXIT
    T_GET_OBJECTS_ABORT_EXIT:
        FROM: @S_GET_OBJECTS
        TO: @S_EXIT

    T_RASTER_SCAN_RETURN_HOME:
        FROM: @S_RASTER_SCAN
        TO: @S_RETURN_TO_HOME_POSE
    T_RASTER_SCAN_EXIT:
        FROM: @S_RASTER_SCAN
        TO: @S_EXIT
    T_RASTER_SCAN_ABORT_EXIT:
        FROM: @S_RASTER_SCAN
        TO: @S_EXIT

    T_RETURN_HOME_MOVE_ARM:
        FROM: @S_RETURN_TO_HOME_POSE
        TO: @S_MOVE_ARM
    T_RETURN_HOME_EXIT:
        FROM: @S_RETURN_TO_HOME_POSE
        TO: @S_EXIT
    T_RETURN_HOME_ABORT_EXIT:
        FROM: @S_RETURN_TO_HOME_POSE
        TO: @S_EXIT

    T_EXECUTE_SCREWDRIVER_PROBE_SELECT_NEXT_OBJECT:
        FROM: @S_EXECUTE_SCREWDRIVER_PROBE
        TO: @S_SELECT_NEXT_OBJECT
    T_EXECUTE_SCREWDRIVER_PROBE_EXIT:
        FROM: @S_EXECUTE_SCREWDRIVER_PROBE
        TO: @S_EXIT
    T_EXECUTE_SCREWDRIVER_PROBE_ABORT_EXIT:
        FROM: @S_EXECUTE_SCREWDRIVER_PROBE
        TO: @S_EXIT

    T_MOVE_ARM_GET_SUBDOOR:
        FROM: @S_MOVE_ARM
        TO: @S_GET_SUBDOOR
    T_MOVE_ARM_EXECUTE_SCREWDRIVER_PROBE:
        FROM: @S_MOVE_ARM
        TO: @S_EXECUTE_SCREWDRIVER_PROBE
    T_MOVE_ARM_CLOSE_GRIPPER:
        FROM: @S_MOVE_ARM
        TO: @S_CLOSE_GRIPPER
    T_MOVE_ARM_MOVE_TO_TABLE_DROP_POSE:
        FROM: @S_MOVE_ARM
        TO: @S_MOVE_TO_TABLE_DROP_POSE
    T_MOVE_ARM_OPEN_GRIPPER:
        FROM: @S_MOVE_ARM
        TO: @S_OPEN_GRIPPER
    T_MOVE_ARM_SELECT_NEXT_OBJECT:
        FROM: @S_MOVE_ARM
        TO: @S_SELECT_NEXT_OBJECT
    T_MOVE_ARM_CONFIRM_DATA:
        FROM: @S_MOVE_ARM
        TO: @S_CONFIRM_DATA
    T_MOVE_ARM_EXIT:
        FROM: @S_MOVE_ARM
        TO: @S_EXIT
    T_MOVE_ARM_ABORT_EXIT:
        FROM: @S_MOVE_ARM
        TO: @S_EXIT

    T_SELECT_NEXT_OBJECT_MOVE_ARM:
        FROM: @S_SELECT_NEXT_OBJECT
        TO: @S_MOVE_ARM
    T_SELECT_NEXT_OBJECT_CONFIRM_DATA:
        FROM: @S_SELECT_NEXT_OBJECT
        TO: @S_CONFIRM_DATA
    T_SELECT_NEXT_OBJECT_EXIT:
        FROM: @S_SELECT_NEXT_OBJECT
        TO: @S_EXIT
    T_SELECT_NEXT_OBJECT_ABORT_EXIT:
        FROM: @S_SELECT_NEXT_OBJECT
        TO: @S_EXIT

    T_CLOSE_GRIPPER_RETREAT_ARM_WITH_OBJECT:
        FROM: @S_CLOSE_GRIPPER
        TO: @S_RETREAT_ARM_WITH_OBJECT
    T_CLOSE_GRIPPER_EXIT:
        FROM: @S_CLOSE_GRIPPER
        TO: @S_EXIT
    T_CLOSE_GRIPPER_ABORT_EXIT:
        FROM: @S_CLOSE_GRIPPER
        TO: @S_EXIT

    T_RETREAT_ARM_WITH_OBJECT_MOVE_ARM:
        FROM: @S_RETREAT_ARM_WITH_OBJECT
        TO: @S_MOVE_ARM
    T_RETREAT_ARM_WITH_OBJECT_EXIT:
        FROM: @S_RETREAT_ARM_WITH_OBJECT
        TO: @S_EXIT
    T_RETREAT_ARM_WITH_OBJECT_ABORT_EXIT:
        FROM: @S_RETREAT_ARM_WITH_OBJECT
        TO: @S_EXIT

    T_MOVE_TO_TABLE_DROP_POSE_MOVE_ARM:
        FROM: @S_MOVE_TO_TABLE_DROP_POSE
        TO: @S_MOVE_ARM
    T_MOVE_TO_TABLE_DROP_POSE_EXIT:
        FROM: @S_MOVE_TO_TABLE_DROP_POSE
        TO: @S_EXIT
    T_MOVE_TO_TABLE_DROP_POSE_ABORT_EXIT:
        FROM: @S_MOVE_TO_TABLE_DROP_POSE
        TO: @S_EXIT

    T_OPEN_GRIPPER_RETURN_HOME_AFTER_DROP:
        FROM: @S_OPEN_GRIPPER
        TO: @S_RETURN_HOME_AFTER_DROP
    T_OPEN_GRIPPER_EXIT:
        FROM: @S_OPEN_GRIPPER
        TO: @S_EXIT
    T_OPEN_GRIPPER_ABORT_EXIT:
        FROM: @S_OPEN_GRIPPER
        TO: @S_EXIT

    T_RETURN_HOME_AFTER_DROP_MOVE_ARM:
        FROM: @S_RETURN_HOME_AFTER_DROP
        TO: @S_MOVE_ARM
    T_RETURN_HOME_AFTER_DROP_EXIT:
        FROM: @S_RETURN_HOME_AFTER_DROP
        TO: @S_EXIT
    T_RETURN_HOME_AFTER_DROP_ABORT_EXIT:
        FROM: @S_RETURN_HOME_AFTER_DROP
        TO: @S_EXIT

    T_CONFIRM_DATA_IDLE:
        FROM: @S_CONFIRM_DATA
        TO: @S_IDLE
    T_CONFIRM_DATA_ABORT_EXIT:
        FROM: @S_CONFIRM_DATA
        TO: @S_EXIT

REACTIONS:
    R_E_START:
        WHEN: @E_START
        DO: @T_IDLE_INITIALIZE
    R_E_ABORT_IDLE:
        WHEN: @E_ABORT
        DO: @T_IDLE_EXIT
    R_E_ABORT_INITIALIZE:
        WHEN: @E_ABORT
        DO: @T_INITIALIZE_ABORT_EXIT
    R_E_ABORT_MOVE_TO_VIEW_POSE:
        WHEN: @E_ABORT
        DO: @T_MOVE_TO_VIEW_POSE_ABORT_EXIT
    R_E_ABORT_GET_SUBDOOR:
        WHEN: @E_ABORT
        DO: @T_GET_SUBDOOR_ABORT_EXIT
    R_E_ABORT_RASTER_SCAN:
        WHEN: @E_ABORT
        DO: @T_RASTER_SCAN_ABORT_EXIT
    R_E_ABORT_RETURN_HOME:
        WHEN: @E_ABORT
        DO: @T_RETURN_HOME_ABORT_EXIT
    R_E_ABORT_MOVE_ARM:
        WHEN: @E_ABORT
        DO: @T_MOVE_ARM_ABORT_EXIT
    R_E_ABORT_EXECUTE_SCREWDRIVER_PROBE:
        WHEN: @E_ABORT
        DO: @T_EXECUTE_SCREWDRIVER_PROBE_ABORT_EXIT
    R_E_ABORT_SELECT_NEXT_OBJECT:
        WHEN: @E_ABORT
        DO: @T_SELECT_NEXT_OBJECT_ABORT_EXIT
    R_E_ABORT_CLOSE_GRIPPER:
        WHEN: @E_ABORT
        DO: @T_CLOSE_GRIPPER_ABORT_EXIT
    R_E_ABORT_RETREAT_ARM_WITH_OBJECT:
        WHEN: @E_ABORT
        DO: @T_RETREAT_ARM_WITH_OBJECT_ABORT_EXIT
    R_E_ABORT_MOVE_TO_TABLE_DROP_POSE:
        WHEN: @E_ABORT
        DO: @T_MOVE_TO_TABLE_DROP_POSE_ABORT_EXIT
    R_E_ABORT_OPEN_GRIPPER:
        WHEN: @E_ABORT
        DO: @T_OPEN_GRIPPER_ABORT_EXIT
    R_E_ABORT_RETURN_HOME_AFTER_DROP:
        WHEN: @E_ABORT
        DO: @T_RETURN_HOME_AFTER_DROP_ABORT_EXIT
    R_E_ABORT_GET_OBJECTS:
        WHEN: @E_ABORT
        DO: @T_GET_OBJECTS_ABORT_EXIT
    R_E_ABORT_CONFIRM_DATA:
        WHEN: @E_ABORT
        DO: @T_CONFIRM_DATA_ABORT_EXIT

    R_E_INIT_DONE:
        WHEN: @E_INIT_DONE
        DO: @T_INITIALIZE_MOVE_TO_VIEW_POSE
    R_E_INIT_FAIL:
        WHEN: @E_INIT_FAIL
        DO: @T_INITIALIZE_EXIT

    R_E_VIEW_POSE_DONE:
        WHEN: @E_VIEW_POSE_DONE
        DO: @T_MOVE_ARM_GET_SUBDOOR
    R_E_VIEW_POSE_FAIL:
        WHEN: @E_VIEW_POSE_FAIL
        DO: @T_MOVE_TO_VIEW_POSE_EXIT
    R_E_VIEW_POSE_FAIL_MOVE_ARM:
        WHEN: @E_VIEW_POSE_FAIL
        DO: @T_MOVE_ARM_EXIT

    R_E_SUBDOOR_DONE:
        WHEN: @E_SUBDOOR_DONE
        DO: @T_GET_SUBDOOR_GET_OBJECTS
    R_E_SUBDOOR_FAIL:
        WHEN: @E_SUBDOOR_FAIL
        DO: @T_GET_SUBDOOR_EXIT

    R_E_OBJECTS_DONE:
        WHEN: @E_OBJECTS_DONE
        DO: @T_GET_OBJECTS_RASTER_SCAN
    R_E_OBJECTS_FAIL:
        WHEN: @E_OBJECTS_FAIL
        DO: @T_GET_OBJECTS_EXIT

    R_E_SCAN_DONE:
        WHEN: @E_SCAN_DONE
        DO: @T_RASTER_SCAN_RETURN_HOME
    R_E_SCAN_FAIL:
        WHEN: @E_SCAN_FAIL
        DO: @T_RASTER_SCAN_EXIT

    R_E_RETURN_HOME_DONE:
        WHEN: @E_RETURN_HOME_DONE
        DO: @T_MOVE_ARM_EXECUTE_SCREWDRIVER_PROBE
    R_E_RETURN_HOME_FAIL:
        WHEN: @E_RETURN_HOME_FAIL
        DO: @T_RETURN_HOME_EXIT
    R_E_RETURN_HOME_FAIL_MOVE_ARM:
        WHEN: @E_RETURN_HOME_FAIL
        DO: @T_MOVE_ARM_EXIT

    R_E_SCREWDRIVER_PROBE_DONE:
        WHEN: @E_SCREWDRIVER_PROBE_DONE
        DO: @T_EXECUTE_SCREWDRIVER_PROBE_SELECT_NEXT_OBJECT
    R_E_SCREWDRIVER_PROBE_FAIL:
        WHEN: @E_SCREWDRIVER_PROBE_FAIL
        DO: @T_EXECUTE_SCREWDRIVER_PROBE_EXIT
    R_E_SCREWDRIVER_PROBE_FAIL_MOVE_ARM:
        WHEN: @E_SCREWDRIVER_PROBE_FAIL
        DO: @T_MOVE_ARM_EXIT

    R_E_OBJECT_READY:
        WHEN: @E_OBJECT_READY
        DO: @T_SELECT_NEXT_OBJECT_MOVE_ARM
    R_E_NO_MORE_OBJECTS:
        WHEN: @E_NO_MORE_OBJECTS
        DO: @T_SELECT_NEXT_OBJECT_CONFIRM_DATA

    R_E_PICK_OBJECT_DONE:
        WHEN: @E_PICK_OBJECT_DONE
        DO: @T_MOVE_ARM_CLOSE_GRIPPER
    R_E_RETREAT_WITH_OBJECT_DONE:
        WHEN: @E_RETREAT_WITH_OBJECT_DONE
        DO: @T_MOVE_ARM_MOVE_TO_TABLE_DROP_POSE
    R_E_MOVE_TO_TABLE_DONE:
        WHEN: @E_MOVE_TO_TABLE_DONE
        DO: @T_MOVE_ARM_OPEN_GRIPPER
    R_E_POST_DROP_HOME_DONE:
        WHEN: @E_POST_DROP_HOME_DONE
        DO: @T_MOVE_ARM_SELECT_NEXT_OBJECT
    R_E_ARM_MOVE_FAIL:
        WHEN: @E_ARM_MOVE_FAIL
        DO: @T_MOVE_ARM_EXIT

    R_E_GRIPPER_CLOSE_DONE:
        WHEN: @E_GRIPPER_CLOSE_DONE
        DO: @T_CLOSE_GRIPPER_RETREAT_ARM_WITH_OBJECT
    R_E_GRIPPER_CLOSE_FAIL:
        WHEN: @E_GRIPPER_FAIL
        DO: @T_CLOSE_GRIPPER_EXIT

    R_E_GRIPPER_OPEN_DONE:
        WHEN: @E_GRIPPER_OPEN_DONE
        DO: @T_OPEN_GRIPPER_RETURN_HOME_AFTER_DROP
    R_E_GRIPPER_OPEN_FAIL:
        WHEN: @E_GRIPPER_FAIL
        DO: @T_OPEN_GRIPPER_EXIT

    R_E_GO_MOVE_ARM_FROM_VIEW_POSE:
        WHEN: @E_GO_MOVE_ARM
        DO: @T_MOVE_TO_VIEW_POSE_MOVE_ARM
    R_E_GO_MOVE_ARM_FROM_RETURN_HOME:
        WHEN: @E_GO_MOVE_ARM
        DO: @T_RETURN_HOME_MOVE_ARM
    R_E_GO_MOVE_ARM_FROM_SELECT_NEXT_OBJECT:
        WHEN: @E_GO_MOVE_ARM
        DO: @T_SELECT_NEXT_OBJECT_MOVE_ARM
    R_E_GO_MOVE_ARM_FROM_RETREAT_ARM_WITH_OBJECT:
        WHEN: @E_GO_MOVE_ARM
        DO: @T_RETREAT_ARM_WITH_OBJECT_MOVE_ARM
    R_E_GO_MOVE_ARM_FROM_MOVE_TO_TABLE_DROP_POSE:
        WHEN: @E_GO_MOVE_ARM
        DO: @T_MOVE_TO_TABLE_DROP_POSE_MOVE_ARM
    R_E_GO_MOVE_ARM_FROM_RETURN_HOME_AFTER_DROP:
        WHEN: @E_GO_MOVE_ARM
        DO: @T_RETURN_HOME_AFTER_DROP_MOVE_ARM

    R_E_POST_DROP_HOME_FAIL:
        WHEN: @E_POST_DROP_HOME_FAIL
        DO: @T_RETURN_HOME_AFTER_DROP_EXIT

    R_E_CONFIRM_DONE:
        WHEN: @E_CONFIRM_DONE
        DO: @T_CONFIRM_DATA_IDLE
